# Multimodal triplet extraction grammar
# Constrains output to valid JSON matching text_triplets + image_info + cross_modal_triplets schema

root ::= "{" ws (kvpair ("," ws kvpair)*)? ws "}"

kvpair ::= string ws ":" ws value

value ::= string | number | "true" | "false" | "null" | array | object

array ::= "[" ws "]" | "[" ws value ("," ws value)* ws "]"
object ::= "{" ws "}" | "{" ws kvpair ("," ws kvpair)* ws "}"

string ::= "\"" chars "\""
chars ::= (esc | [^"\\])*

number ::= "-"? integer frac? exp?
integer ::= "0" | [1-9] [0-9]*
frac ::= "." [0-9]+
exp ::= ("e" | "E") ("+" | "-")? [0-9]+

esc ::= "\\" [\\/"bfnrt] | "\\u" hex hex hex hex
hex ::= [0-9a-fA-F]

ws ::= [ \t\n\r]*
