# Triplet extraction grammar for batch/single text knowledge graph construction
# Constrains output to valid JSON matching the triplets schema

root ::= "{" ws "\"triplets\"" ws ":" ws array ws "}"

array ::= "[" ws "]" | "[" ws triplet ("," ws triplet)* ws "]"

triplet ::= "{" ws pair ("," ws pair)* ws "}"

pair ::= string ws ":" ws value

string ::= "\"" chars "\""
chars ::= (esc | [^"\\])*

value ::= string | number | "true" | "false" | "null"

number ::= "-"? integer frac? exp?
integer ::= "0" | [1-9] [0-9]*
frac ::= "." [0-9]+
exp ::= ("e" | "E") ("+" | "-")? [0-9]+

esc ::= "\\" [\\/"bfnrt] | "\\u" hex hex hex hex
hex ::= [0-9a-fA-F]

ws ::= [ \t\n\r]*
